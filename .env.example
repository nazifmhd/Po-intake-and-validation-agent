# ---------------------------------------------------------------------------
# PO Intake & Validation Agent - configuration
# Copy to .env and fill in. Every threshold the decision policy uses lives here.
# ---------------------------------------------------------------------------

# --- LLM (extraction + policy reasoning) -----------------------------------
# anthropic | openai | heuristic   (heuristic = offline regex/CSV parser, no API key, no vision)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  - extraction is well-specified, medium is plenty
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta) - routes a classifier refusal to a fallback model
ANTHROPIC_SERVER_FALLBACK=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120
EXTRACTION_VALIDATION_RETRIES=2
# Let the LLM read retrieved policy clauses and add (never remove) flags
POLICY_LLM_REVIEW=true

# --- Embeddings / knowledge base -------------------------------------------
# local (fastembed BAAI/bge-small-en-v1.5, no key) | openai (text-embedding-3-small) | none (lexical only)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=storage/chroma
# Set false to run the ablation (KB off): shows what RAG catches
RAG_ENABLED=true

# --- Decision thresholds (section 6 of the blueprint) ----------------------
CRITICAL_FIELD_CONFIDENCE_MIN=0.80
PRICE_TOLERANCE_PCT=10
AUTO_APPROVAL_LIMIT=10000
SINGLE_PO_HARD_LIMIT=50000
VENDOR_MATCH_HIGH=90
VENDOR_MATCH_MEDIUM=75
VENDOR_AMBIGUITY_MARGIN=5
CATALOG_MATCH_MIN=80
ARITHMETIC_ABS_TOLERANCE=0.05
ARITHMETIC_REL_TOLERANCE=0.001
ALLOWED_PAYMENT_TERMS=Net 30,Net 45,Net 60
BASE_CURRENCY=USD

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///storage/po_agent.db
STORAGE_DIR=storage
MAX_ATTACHMENT_MB=20

# --- Email intake ----------------------------------------------------------
# mailgun | sendgrid | generic
WEBHOOK_PROVIDER=mailgun
MAILGUN_SIGNING_KEY=change-me-mailgun-signing-key
# shared secret for sendgrid (?token=) and generic (X-Webhook-Secret header, used by n8n)
WEBHOOK_SHARED_SECRET=change-me-shared-secret
WEBHOOK_MAX_AGE_SECONDS=900
# Only accept mail from these sender domains (comma separated). Empty = accept all.
ALLOWED_SENDER_DOMAINS=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=30

# For scripts/send_test_email.py
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TEST_EMAIL_TO=

# --- Notifications ---------------------------------------------------------
SLACK_WEBHOOK_URL=
REVIEW_UI_URL=http://localhost:8501

# --- Optional Google Sheets mirror ("Approved" / "Needs Review" tabs) -------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
